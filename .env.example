# Copy to .env and fill in. Never commit .env.
# Generate crypto keys with: make keygen

DATABASE_URL=postgresql+asyncpg://work_service:work_service@127.0.0.1:5432/work_service
TEST_DATABASE_URL=postgresql+asyncpg://work_service:work_service@127.0.0.1:5432/work_service_test
POSTGRES_PASSWORD=work_service

# AES-256-GCM keys for field encryption: "id:base64key[,id:base64key...]", highest id encrypts
FIELD_ENCRYPTION_KEYS=
# HMAC key for email lookup hash (base64)
EMAIL_HASH_KEY=

# This email gets the "owner" role (the only user allowed to use the Claude subscription)
OWNER_EMAIL=
CONSENT_VERSION=2026-10-18

# From @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# NEVER set ANTHROPIC_API_KEY. Processes unset it at startup.
